{
  "name": "dsh-task-alerts",
  "version": "1.0.0",
  "description": "DeepSeek Harness task-execution alerts: glassmorphism reminder panel and toast in the Web UI, sound alerts, global stop hotkey, and TXT reports for problems the agent failed to solve.",
  "type": "module",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.5-rc.1"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "alert",
    "notification",
    "glassmorphism",
    "toast"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "config.yaml",
    "alert.wav",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "smoke": "node scripts/smoke-host.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5-rc.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "js-yaml": "^4.2.0",
    "node-global-key-listener": "^0.3.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
